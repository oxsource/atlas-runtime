# Bazel build artifacts and symlinks
bazel-*

# Auto-generated platform setup (machine-local, DO NOT commit)
.user.bazelrc
.configure.bazelrc

# macOS metadata
.DS_Store

# Editor / IDE directories
.idea/
.vscode/
*.swp
*.swo

# Compiled object files and binaries
*.o
*.a
*.so
*.dylib

# Python bytecode (in case any scripts are added later)
__pycache__/
*.pyc

# Atlas SDK build output
atlas-sdk/

# Example build output
examples/**/build/

# Environment and secrets
.venv*/
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
credentials.json
service-account.json
