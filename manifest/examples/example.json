{
  "version": "1.0",
  "name": "my-vision-app",
  "models": [
    {
      "id": "detector",
      "name": "YOLOv8 Object Detector",
      "backend": "onnx",
      "model_path": "${MODEL_DIR}/yolov8n.onnx",
      "inputs": [
        {
          "name": "images",
          "shape": [1, 3, 640, 640],
          "dtype": "float32",
          "layout": "NCHW",
          "normalize": {
            "mean": [0.485, 0.456, 0.406],
            "std":  [0.229, 0.224, 0.225]
          }
        }
      ],
      "outputs": [
        {
          "name": "output0",
          "shape": [1, 84, 8400],
          "dtype": "float32"
        }
      ],
      "config": {
        "num_threads": "4",
        "execution_mode": "sequential"
      }
    },
    {
      "id": "classifier",
      "name": "MobileNetV3 Classifier",
      "backend": "onnx",
      "model_path": "${MODEL_DIR}/mobilenetv3.onnx",
      "inputs": [
        {
          "name": "input",
          "shape": [1, 3, 224, 224],
          "dtype": "float32",
          "layout": "NCHW",
          "normalize": {
            "mean": [0.485, 0.456, 0.406],
            "std":  [0.229, 0.224, 0.225]
          }
        }
      ],
      "outputs": [
        {
          "name": "output",
          "shape": [1, 1000],
          "dtype": "float32"
        }
      ]
    }
  ]
}
