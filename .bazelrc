# The bazelrc file for FilamentAVM OSS.

# Basic build settings
build --jobs 128
build --enable_platform_specific_config

# Linux
build:linux --cxxopt=-std=c++17
build:linux --host_cxxopt=-std=c++17
#build:linux --copt=-w
build:linux --define=xnn_enable_avx512amx=false

build:linux --copt=-Wno-unused-but-set-variable

# Linux x86_64 configs.
build:linux_x86_64 --config=linux
build:linux_x86_64 --platforms=//falcon:linux_x86_64_platform
build:linux_x86_64 --action_env=LD_LIBRARY_PATH=/opt/LLVM-19.1.6-Linux-X64/lib
build:linux_x86_64 --action_env=CC=/opt/LLVM-19.1.6-Linux-X64/bin/clang
build:linux_x86_64 --action_env=CXX=/opt/LLVM-19.1.6-Linux-X64/bin/clang++
build:linux_x86_64 --linkopt=-Wl,-rpath,/opt/LLVM-19.1.6-Linux-X64/lib/x86_64-unknown-linux-gnu
build:linux_x86_64 --cxxopt=-std=c++17
build:linux_x86_64 --linkopt=-lc++
build:linux_x86_64 --cxxopt=-stdlib=libstdc++
build:linux_x86_64 --linkopt=-stdlib=libstdc++
build:linux_x86_64 --linkopt=-lc++abi

# Android configs.
# Note: the documentation tells us to use @androidndk//:default_crosstool, but
# the automatic configuration transition uses //external:android/crosstool.
# Using it here works and spares us from having two different config_settings
# for Android.
build:android --crosstool_top=//external:android/crosstool
build:android --host_crosstool_top=@bazel_tools//tools/cpp:toolchain
build:android --linkopt=-landroid
build:android --linkopt=-ldl
build:android --linkopt=-llog
build:android --linkopt=-lm
build:android --linkopt=-Wl,--gc-sections
# TODO: Remove this flag once we updated to NDK 25
build:android --define=xnn_enable_arm_i8mm=false

build:android_arm --config=android
build:android_arm --platforms=//falcon:android_arm_platform
build:android_arm --cpu=armeabi-v7a
build:android_arm --fat_apk_cpu=armeabi-v7a

build:android_arm64 --config=android
build:android_arm64 --platforms=//falcon:android_arm64_platform
build:android_arm64 --cpu=arm64-v8a
build:android_arm64 --fat_apk_cpu=arm64-v8a

# Turn off maximum stdout size
build --experimental_ui_max_stdouterr_bytes=-1

# This bazelrc file is meant to be written by a setup script.
try-import %workspace%/.configure.bazelrc

# This bazelrc file can be used for user-specific custom build settings.
try-import %workspace%/.user.bazelrc
