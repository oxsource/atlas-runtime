# Default build flags for all targets.
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# Treat warnings as errors for project sources (optional, can be removed if too strict).
# build --cxxopt=-Werror

# Platform shortcuts (use: bazel build //... --config=<name>)
build:macos_arm64    --platforms=//platforms:macos_arm64_platform
build:macos_x86_64   --platforms=//platforms:macos_x86_64_platform
build:linux_x86_64   --platforms=//platforms:linux_x86_64_platform
build:linux_aarch64  --platforms=//platforms:linux_aarch64_platform

# Android cross-compilation
# Prerequisites: ANDROID_NDK_HOME must point to NDK root (>= r25b).
# Uses rules_android_ndk which supports NDK r25b+ with Bazel 6.5+.
# --crosstool_top forces the NDK compiler; --platforms selects NDK toolchain;
# --cpu sets the target ABI.
build:android                --crosstool_top=//external:android/crosstool
build:android                --host_crosstool_top=@bazel_tools//tools/cpp:toolchain
build:android_arm64          --config=android
build:android_arm64          --platforms=//platforms:android_arm64_platform
build:android_arm64          --cpu=arm64-v8a
build:android_x86_64         --config=android
build:android_x86_64         --platforms=//platforms:android_x86_64_platform
build:android_x86_64         --cpu=x86_64
