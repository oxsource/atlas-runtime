# BUILD file for nlohmann/json (header-only).
# The archive unpacks to json-3.11.3/, and the single-include header lives at
# single_include/nlohmann/json.hpp.

cc_library(
    name = "json",
    hdrs = ["single_include/nlohmann/json.hpp"],
    includes = ["single_include"],
    visibility = ["//visibility:public"],
)
