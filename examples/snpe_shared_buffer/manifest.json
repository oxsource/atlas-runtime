{
  "version": "1.0",
  "name": "snpe-shared-buffer-demo",
  "models": [
    {
      "id": "model_a",
      "name": "Shared Buffer Model A",
      "backend": "snpe",
      "model_path": "${SAMPLE_MODEL_DIR}/model_a.dlc",
      "load_strategy": "eager",
      "inputs": [
        {
          "name": "input",
          "shape": [1, 3, 4, 4],
          "dtype": "float32",
          "layout": "NCHW"
        }
      ],
      "outputs": [
        {
          "name": "output",
          "shape": [1, 3, 4, 4],
          "dtype": "float32"
        }
      ],
      "config": {
        "runtime": "cpu",
        "use_buffer": "true",
        "shared_input": "camera_feed"
      }
    },
    {
      "id": "model_b",
      "name": "Shared Buffer Model B",
      "backend": "snpe",
      "model_path": "${SAMPLE_MODEL_DIR}/model_b.dlc",
      "load_strategy": "eager",
      "inputs": [
        {
          "name": "input",
          "shape": [1, 3, 4, 4],
          "dtype": "float32",
          "layout": "NCHW"
        }
      ],
      "outputs": [
        {
          "name": "output",
          "shape": [1, 3, 4, 4],
          "dtype": "float32"
        }
      ],
      "config": {
        "runtime": "cpu",
        "use_buffer": "true",
        "shared_input": "camera_feed"
      }
    }
  ]
}
